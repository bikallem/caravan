; The examples run in Weft_os, the world of weft for the OS of the build.

(executables
 (names hello middleware router ws_echo fetch readme)
 (modules hello middleware router ws_echo fetch readme)
 (libraries
  caravan
  caravan.websocket
  caravan.client
  caravan.router
  weft
  weft.os))

; The first OCaml example of README.md. The rule copies it to readme.ml, so the
; build fails if this example of the README does not compile. section.awk
; fails if README.md has no OCaml example.

(rule
 (action
  (with-stdout-to
   readme.ml
   (run awk -v "section=" -f %{dep:section.awk} %{dep:../README.md}))))

; The example of the Testing section of README.md, as readme_testing.ml.

(executable
 (name readme_testing)
 (modules readme_testing)
 (libraries caravan caravan.testing weft))

(rule
 (action
  (with-stdout-to
   readme_testing.ml
   (run awk -v "section=Testing" -f %{dep:section.awk} %{dep:../README.md}))))

