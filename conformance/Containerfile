# The tool of cispa/http-conformance (commit 24f75be) for make conformance.
# The image has the upstream code without changes, except the dpkt patch that
# the upstream README also requires. The submodules are not cloned: REDbot runs
# only for https, and wpt is only for the sanity check.

# python:3.10-slim-bookworm, 2026-10-06.
FROM docker.io/library/python@sha256:5be5aaecb962a41567bc8041f1e9e3432cb085b037fe057f9a562630b2e4b370

RUN apt-get update \
 && apt-get install -y --no-install-recommends git gcc libc6-dev libpq-dev \
 && rm -rf /var/lib/apt/lists/*

# The version of Poetry that wrote the upstream lock file.
RUN pip install --no-cache-dir poetry==1.5.1

RUN git clone https://github.com/cispa/http-conformance /opt/http-conformance \
 && git -C /opt/http-conformance checkout 24f75be

# The runner uses paths relative to the repository root.
WORKDIR /opt/http-conformance

ENV POETRY_VIRTUALENVS_IN_PROJECT=true
RUN poetry install --no-root --without dev --no-interaction

COPY patch_dpkt.py /opt/glue-tools/patch_dpkt.py
RUN poetry run python /opt/glue-tools/patch_dpkt.py

# Make the mitmproxy CA now. If mitmdump makes it during the run, the runner
# can send its first probes before mitmdump listens.
RUN poetry run python -c \
    "from mitmproxy.certs import CertStore; CertStore.from_store('/root/.mitmproxy', 'mitmproxy', 2048)" \
 && test -f /root/.mitmproxy/mitmproxy-ca.pem

# mitmdump listens only on the loopback interface, so it is not an open proxy.
RUN printf 'listen_host: 127.0.0.1\n' > /root/.mitmproxy/config.yaml

# The Tranco stub. mitmdump inherits PYTHONPATH.
COPY glue/tranco.py /opt/glue/tranco.py
ENV PYTHONPATH=/opt/glue
