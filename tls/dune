; TLS: an engine that wraps another engine, and HTTPS for the client. The TLS
; flow is that of weft-tls. Optional: dune builds it only if weft-tls and tls
; are installed.

(library
 (name caravan_tls)
 (public_name caravan.tls)
 (optional)
 (libraries
  caravan
  weft
  weft.flow
  weft-tls
  tls
  x509
  domain-name
  ipaddr
  mirage-crypto-rng)
 (instrumentation
  (backend ppx_windtrap.mutate))
 (instrumentation
  (backend ppx_windtrap.coverage)))
