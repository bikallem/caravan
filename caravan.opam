# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "HTTP server built on affect, growing into a proxy"
description:
  "Caravan is an HTTP/1.1 server for OCaml 5 built on the affect concurrency model. It streams bodies, shuts down gracefully, and hands connections over for WebSocket and CONNECT tunnels; it is designed to grow into HTTP/2, HTTP/3 and a reverse proxy."
maintainer: ["Bikal Gurung <gbikal@gmail.com>"]
authors: ["Bikal Gurung <gbikal@gmail.com>"]
license: "MPL-2.0"
homepage: "https://github.com/bikallem/caravan"
bug-reports: "https://github.com/bikallem/caravan/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.5.0"}
  "affect" {>= "0.0.0"}
  "http-date" {>= "0.2"}
  "weft" {with-test}
  "windtrap" {with-test & >= "0.2.0"}
  "ppx_windtrap" {with-test & >= "0.2.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/bikallem/caravan.git"
x-maintenance-intent: ["(latest)"]
