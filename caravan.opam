# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "HTTP/1.1 server, client and WebSocket built on weft"
description:
  "Caravan is an HTTP/1.1 server, client and WebSocket library for OCaml 5, built on the weft concurrency library. It streams bodies, shuts down gracefully, and gives connections to WebSocket and CONNECT tunnels. The design leaves room for HTTP/2, HTTP/3 and a reverse proxy."
maintainer: ["Bikal Gurung <gbikal@gmail.com>"]
authors: ["Bikal Gurung <gbikal@gmail.com>"]
license: "MPL-2.0"
homepage: "https://github.com/bikallem/caravan"
bug-reports: "https://github.com/bikallem/caravan/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.5.0"}
  "http-date" {>= "0.2"}
  "weft"
  "windtrap" {with-test & >= "0.2.0"}
  "ppx_windtrap" {with-test & >= "0.2.0"}
  "odoc" {with-doc}
  "mirage-crypto-rng" {with-test}
  "mirage-crypto-ec" {with-test}
  "ptime" {with-test}
  "tls" {with-test & >= "2.1"}
  "digestif" {with-test}
  "eqaf" {with-test}
  "mirage-crypto-pk" {with-test}
  "yojson" {with-test}
  "zarith" {with-test}
  "decompress" {with-test}
]
depopts: [
  "tls" {>= "2.1"}
  "x509"
  "domain-name"
  "mirage-crypto-rng"
  "digestif"
  "eqaf"
  "mirage-crypto-pk"
  "mirage-crypto-ec"
  "yojson"
  "zarith"
  "decompress"
]
conflicts: [
  "tls" {< "2.1"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/bikallem/caravan.git"
x-maintenance-intent: ["(latest)"]
